# Public Vite configuration. This App ID is safe to expose in the browser.
VITE_PRIVY_APP_ID=
# Optional smart-contract deployment overrides. Base Sepolia defaults these to the
# deployer; Base mainnet defaults both to the Skillsbay Safe.
# INITIAL_OWNER_ADDRESS=
# PLATFORM_TREASURY_ADDRESS=
# Address deployed from packages/contracts on Base Sepolia.
VITE_SKILL_REGISTRY_ADDRESS=
# CLI-only build-time API origin. The published CLI is set to production by
# GitHub Actions; use a local Worker URL here when testing a local CLI build.
SKILLSBAY_API_URL=http://localhost:5173
