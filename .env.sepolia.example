# Base Sepolia contract deployment. Copy to .env.sepolia and fill the blanks.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
DEPLOYER_PRIVATE_KEY=
# Circle test USDC on Base Sepolia.
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Public address derived from the dedicated RECORDER_PRIVATE_KEY. Circle Paymaster
# turns this into the EIP-7702 recorder account, so it needs USDC but not ETH.
RECORDER_ADDRESS=
