{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "skillsbay",
	"main": "./worker/index.ts",
	"compatibility_date": "2026-09-04",
	"workers_dev": false,
	"routes": [
		{
			"pattern": "skillsbay.dev",
			"custom_domain": true,
		},
	],
	"assets": {
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/",
			"/v1/*",
			"/*/*",
			"/skills/*",
			"!/assets/*",
			"!/@*",
			"!/src/*",
			"!/node_modules/*",
			"!/favicon.*",
			"!/skillsbay-*.png",
			"!/skillsbay-*.svg",
			"!/icons.svg",
			"!/*.ico"
		],
	},
	"vars": {
		"APP_ENV": "production",
		"BASE_CHAIN_ID": "8453",
		"BASE_RPC_URL": "https://mainnet.base.org",
		"GRAPH_API_URL": "https://api.studio.thegraph.com/query/89068/skillsbay-base-mainnet/v0.1.0",
		"SKILL_REGISTRY_ADDRESS": "0x9E2BDB2D1c61C5B9Dee8D7e9E08DDAcCb18bFe06",
		"X402_RECIPIENT_ADDRESS": "0x9E2BDB2D1c61C5B9Dee8D7e9E08DDAcCb18bFe06",
		"USDC_ADDRESS": "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913",
		"X402_NETWORK": "eip155:8453",
		"X402_FACILITATOR_URL": "https://facilitator.payai.network",
		"BUNDLER_RPC_URL": "https://public.pimlico.io/v2/8453/rpc",
		"CIRCLE_PAYMASTER_ADDRESS": "0x6C973eBe80dCD8660841D4356bf15c32460271C9",
		"CIRCLE_PAYMASTER_PERMIT_USDC": "10000000",
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "skillsbay",
			"database_id": "247cbbb3-c931-4547-8b2e-31d114b13cea",
			"migrations_dir": "db/migrations",
		},
	],
	"r2_buckets": [
		{
			"binding": "SKILL_BUNDLES",
			"bucket_name": "skillsbay-skill-bundles",
		},
	],
	"kv_namespaces": [
		{
			"binding": "CHECKOUT_TOKENS",
			"id": "2f14b5eae9de4f11a9335d810ad59aee",
			"preview_id": "768b42b9776741a788a4a7fa1c305ce4"
		}
	],
	"ratelimits": [
		{
			"name": "CHECKOUT_RATE_LIMITER",
			"namespace_id": "731542901",
			"simple": {
				"limit": 20,
				"period": 60
			}
		},
		{
			"name": "PUBLISH_RATE_LIMITER",
			"namespace_id": "731542902",
			"simple": {
				"limit": 6,
				"period": 60
			}
		}
	],
}
