# Base mainnet contract deployment. Copy to .env.mainnet and fill the blanks.
BASE_MAINNET_RPC_URL=https://mainnet.base.org
DEPLOYER_PRIVATE_KEY=
# Circle native USDC on Base mainnet.
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# Public address derived from the dedicated RECORDER_PRIVATE_KEY. Circle Paymaster
# turns this into the EIP-7702 recorder account, so it needs USDC but not ETH.
RECORDER_ADDRESS=
SKILL_REGISTRY_ADDRESS=
# Production x402 facilitator used by the Worker for autonomous purchases.
X402_FACILITATOR_URL=https://facilitator.payai.network
# Worker runtime configuration. Store RECORDER_PRIVATE_KEY as a Cloudflare
# secret; do not put it in this file or commit it.
X402_RECIPIENT_ADDRESS=
BASE_CHAIN_ID=8453
BASE_RPC_URL=https://mainnet.base.org
X402_NETWORK=eip155:8453
# Suitable for a controlled launch rehearsal. Use a dedicated production
# bundler endpoint before opening the marketplace broadly.
BUNDLER_RPC_URL=https://public.pimlico.io/v2/8453/rpc
CIRCLE_PAYMASTER_ADDRESS=0x6C973eBe80dCD8660841D4356bf15c32460271C9
CIRCLE_PAYMASTER_PERMIT_USDC=10000000
# Set after deploying the Base-mainnet subgraph.
GRAPH_API_URL=
