# Base mainnet contract deployment. Copy to .env.mainnet and fill the blanks.
BASE_MAINNET_RPC_URL=https://mainnet.base.org
DEPLOYER_PRIVATE_KEY=
# Circle native USDC on Base mainnet.
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# Public address derived from the dedicated RECORDER_PRIVATE_KEY. Circle Paymaster
# turns this into the EIP-7702 recorder account, so it needs USDC but not ETH.
RECORDER_ADDRESS=
